# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://auth.flowcfo.net

# Must be the same PostgreSQL database that holds the product tables.
DATABASE_URL=postgresql://user:password@host:5432/flowcfo

# Transactional email
RESEND_API_KEY=
FROM_EMAIL=FlowCFO <no-reply@flowcfo.net>

# Legacy API (admin, onboarding, CSV import)
NEXT_PUBLIC_API_URL=https://app.flowcfo.net
NEXT_PUBLIC_AUTH_URL=https://auth.flowcfo.net
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Product API (pitch demos, product workspace screens). NEXT_PUBLIC_* values are
# compiled into the bundle at build time, so set this before building.
NEXT_PUBLIC_PRODUCT_API_URL=https://flowcfo-api.containers.snapdeploy.app

# Local-only pitch preview bearer. Never set this in production.
NEXT_PUBLIC_PITCH_TEST_BEARER=
